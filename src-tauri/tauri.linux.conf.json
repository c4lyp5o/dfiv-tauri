{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"targets": ["deb", "rpm"],
		"linux": {
			"deb": {
				"depends": ["libmpv2 | libmpv1"],
				"files": {
					"/usr/lib/libmpv-wrapper.so": "lib/libmpv-wrapper.so"
				}
			},
			"rpm": {
				"depends": ["mpv-libs"],
				"files": {
					"/usr/lib64/libmpv-wrapper.so": "lib/libmpv-wrapper.so"
				}
			}
		}
	}
}
